{
  "name": "@hyperse/html-webpack-plugin-loader",
  "version": "1.0.8",
  "description": "A custom template loader that parses HTML templates for the `html-webpack-plugin` package",
  "keywords": [
    "hyperse",
    "typescript",
    "webpack",
    "rspack",
    "html-webpack-plugin",
    "html-loader"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/html-webpack-plugin-loader.git"
  },
  "type": "module",
  "exports": {
    "./loader": {
      "require": "./dist/loader/htmlLoader.cjs",
      "default": "./dist/loader/htmlLoader.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "node --import @hyperse/ts-node/register ./scripts/build.ts",
    "next": "next build",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-task": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "lint-staged-files": "lint-staged --allow-empty",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "cz": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@hyperse/eslint-config-hyperse": "^1.7.3",
    "@hyperse/ts-node": "^1.2.0",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.5.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "webpack": "^5.107.2"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
